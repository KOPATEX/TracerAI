<Window x:Class="TracerAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TracerAI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"  />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>

        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.Row="1">
            <StackPanel Background="Gray">
                <TextBlock Text="Project" TextAlignment="Center" />
                <Button Content="PCB"/>
                <Button Content="SCH"/>
                <Button Content="LIB_PCB"/>
                <Button Content="LIB_SCH"/>
                <Button Content="AI"/>
            </StackPanel>
        </Grid>
        
        
        <Grid Grid.Column="2" Grid.Row="1">
            
            <StackPanel Background="Gray">
                
               

            </StackPanel>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="2">
            <StackPanel Background="Gray" Orientation="Horizontal">
                <Button Content="PCB" />
                <Button Content="SCH"/>
            </StackPanel>
            
        </Grid>


        </Grid>
</Window>
