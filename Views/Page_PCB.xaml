<UserControl x:Class="TracerAI.Views.Page_PCB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skiasharp="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Loaded="UserControl_Loaded"
             Focusable="True">

    <!-- 🟢 Добавляем перехват клавиши Tab через InputBindings -->
    <UserControl.InputBindings>
        <KeyBinding Key="Tab" Command="{Binding SelectConnectedCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Back" Command="{Binding DeleteSelectedCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#1E1E1E">
            <skiasharp:SKElement x:Name="SkiaCanvas"
             MouseEnter="OnCanvasMouseEnter"
             MouseLeave="OnCanvasMouseLeave"
             PaintSurface="OnPaintSurface"
             MouseMove="OnCanvasMouseMove"
             MouseDown="OnCanvasMouseDown"
             MouseWheel="OnCanvasMouseWheel"
             
             Focusable="True"/>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Background="Gray" Orientation="Horizontal">
                <Button Background="White" Content="+"/>
                
            </StackPanel>
            
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Background="#333333" Orientation="Horizontal">
                <Button Content="Define Board Shape" 
                Command="{Binding DefineBoardShapeCommand}" 
                Margin="4,2" Padding="8,2" Foreground="Black"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>